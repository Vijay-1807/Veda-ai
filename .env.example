# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Server-side only. The router uses this order and skips providers without keys.
AI_PRIMARY_PROVIDER=gemini36
AI_FALLBACK_PROVIDER=gemini35

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI35_MODEL=gemini-3.5-flash

# Conduit (OpenAI & Anthropic compatible proxy with $500 balance)
CONDUIT_API_KEY=
CONDUIT_MODEL=gemini-2.5-flash
CONDUIT_BASE_URL=https://conduit.ozdoev.net/v1

# Optional active providers. Both key and exact base URL are required.
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=

NAVYAI_API_KEY=
NAVYAI_BASE_URL=
NAVYAI_MODEL=gemini-2.5-flash

MONYET_API_KEY=
MONYET_MODEL=myt/gemini-3.5-flash-free
MONYET_BASE_URL=https://tokenin.my.id/v1

GLM_API_KEY=
GLM_MODEL=glm-4.6v-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# NVIDIA Nemotron OCR v2 (Specialized OCR & Layout Engine)
NVIDIA_OCR_API_KEY=
NVIDIA_OCR_MODEL=nemotron-ocr-v2
NVIDIA_OCR_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

# NVIDIA Nemotron Omni (Reasoning VLM)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
