# Server-side only. Never prefix these with NEXT_PUBLIC_.
# The router uses its verified phase order and skips providers without keys.

GEMINI_API_KEY=
GEMINI35_MODEL=gemini-3.5-flash

# Ollama Cloud vision fallbacks
OLLAMA_CLOUD_API_KEY=
OLLAMA_GEMMA_MODEL=gemma4:31b
OLLAMA_MINIMAX_MODEL=minimax-m3

# Optional active providers. Both key and exact base URL are required.
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=

NAVYAI_API_KEY=
NAVYAI_BASE_URL=
NAVYAI_MODEL=gemini-2.5-flash

MONYET_API_KEY=
MONYET_MODEL=myt/gemini-3.5-flash-free
MONYET_BASE_URL=https://tokenin.my.id/v1

# NVIDIA Nemotron OCR v2 (Specialized OCR & Layout Engine)
NVIDIA_OCR_API_KEY=
NVIDIA_OCR_MODEL=nemotron-ocr-v2
NVIDIA_OCR_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

# NVIDIA Nemotron Omni (Reasoning VLM)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
